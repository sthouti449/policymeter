# ---------- Provider selection ----------
# Chat and embeddings are chosen separately because Anthropic has no embeddings API.
# auto = Azure if configured, else OpenAI, else Anthropic (embeddings: Azure, else OpenAI).
# Or force one: azure | openai | anthropic  (embeddings: azure | openai only)
LLM_CHAT_PROVIDER=anthropic
LLM_EMBED_PROVIDER=openai

# ---------- Anthropic (chat) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5
# Thinking effort. low keeps hidden thinking small so max_tokens goes to the answer.
ANTHROPIC_EFFORT=low
# Hidden thinking eats max_tokens. The fast tier must not think (a blank answer happened once with it on).
# The smart tier (the judge) rejects "disabled", so it keeps the model default.
ANTHROPIC_THINKING_FAST=disabled
ANTHROPIC_THINKING_SMART=omit

# ---------- OpenAI (embeddings; also a chat fallback) ----------
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL_FAST=gpt-5.4-mini
OPENAI_CHAT_MODEL_SMART=gpt-5.5
# Optional. Set (e.g. low) for GPT-5-family chat models so reasoning doesn't eat max tokens.
OPENAI_REASONING_EFFORT=

# ---------- Azure OpenAI (the production path; unused in this setup) ----------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# GPT-5-family models need a recent API version; check what your resource supports.
AZURE_OPENAI_API_VERSION=
# Deployment names are whatever you named them in Azure AI Foundry
AZURE_CHAT_DEPLOYMENT_FAST=
AZURE_CHAT_DEPLOYMENT_SMART=
AZURE_EMBED_DEPLOYMENT=
# Keys into config/pricing.json for each deployment
AZURE_CHAT_FAST_PRICING_KEY=azure:gpt-5.4-mini
AZURE_CHAT_SMART_PRICING_KEY=azure:gpt-5.5
AZURE_EMBED_PRICING_KEY=azure:text-embedding-3-small

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- RAG ----------
RAG_MATCH_COUNT=6
# Calibrated with `npm run calibrate`: out-of-scope questions peaked at 0.39 and in-scope ones started at 0.47. Re-run it after adding documents.
RAG_MIN_SIMILARITY=0.42
RAG_HYBRID=true
EMBEDDING_DIMENSIONS=1536

# ---------- Guardrails ----------
DAILY_SPEND_CAP_USD=2.00
# The "Ask about this demo" widget has its own small cap so reviewers can't be locked out.
DEMO_DAILY_SPEND_CAP_USD=0.50
RATE_LIMIT_PER_MINUTE=8
MAX_QUESTION_CHARS=1000
# Salt for hashing IPs before storing them
IP_HASH_SALT=change-me-to-a-random-string

# ---------- Alerts (optional) ----------
# Teams/Slack incoming-webhook URL. Leave blank to only show alerts in the dashboard.
ALERT_WEBHOOK_URL=

# ---------- Admin ----------
# Required header value (x-admin-token) for POST /api/evals/run
ADMIN_TOKEN=change-me

# ---------- Site ----------
NEXT_PUBLIC_SITE_NAME=PolicyMeter
NEXT_PUBLIC_BUILDER_NAME=Suresh Thouti
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/sthouti
NEXT_PUBLIC_GITHUB_URL=https://github.com/sureshkumarthouti-lang
